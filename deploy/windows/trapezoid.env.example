# Production environment for the Trapezoid service (TRP-T20).
# Copy to <InstallRoot>\config\trapezoid.env on the host. Readable by Administrators, SYSTEM and the
# service account only (Install-TrapezoidHost.ps1 sets this). Never commit the copy.
# Every key is validated at startup (apps/api/src/config/env.ts); see apps/api/.env.example too.

APP_ENV=production
# All interfaces, so office computers and phones can connect; the firewall limits who can.
HOST=0.0.0.0
# IT INPUT: HTTPS port (must match HttpsPort in host.config.psd1).
PORT=443
# The app role (least privilege), never the migration role or postgres. 127.0.0.1 only.
DATABASE_URL=postgres://trapezoid_app:CHANGE-ME@127.0.0.1:5432/trapezoid
# At least 32 random characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
LOG_LEVEL=info
BUSINESS_TIME_ZONE=America/Edmonton
PERSONAL_SESSION_HOURS=12
RECEIPT_MAX_UNITS=50
# The built web app, served from the same origin as the API.
WEB_DIST_DIR=C:\Trapezoid\current\apps\web\dist

# IT INPUT: the certificate for the production host name, trusted by office computers and phones.
# Either a PFX file and its passphrase ...
TLS_PFX_FILE=C:\Trapezoid\config\tls\trapezoid.pfx
TLS_PFX_PASSPHRASE=
# ... or a PEM certificate chain and private key (leave the PFX keys empty then).
# TLS_CERT_FILE=C:\Trapezoid\config\tls\trapezoid.crt
# TLS_KEY_FILE=C:\Trapezoid\config\tls\trapezoid.key

# Never in production.
ENABLE_TEST_AUTH=false

# Label printer (TRP-T15) and Microsoft sign-in (TRP-T05): see apps/api/.env.example. Sign-in timing
# is deferred (D38); fill these in only when that is decided. In production MICROSOFT_REDIRECT_URI
# must be https://<production host name>/sign-in/microsoft/callback.
LABEL_PRINTER_HOST=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
BOOTSTRAP_ADMIN_OBJECT_ID=
