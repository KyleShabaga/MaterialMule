# Migration role connection for Deploy-MaterialMule.ps1 (MM-T20).
# Copy to <InstallRoot>\config\admin\migrate.env (Administrators only). Only DATABASE_URL belongs
# here; the deploy script takes every other setting from materialmule.env. Never commit the copy.
DATABASE_URL=postgres://materialmule_owner:CHANGE-ME@127.0.0.1:5432/materialmule
