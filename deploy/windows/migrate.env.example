# Migration role connection for Deploy-Trapezoid.ps1 (TRP-T20).
# Copy to <InstallRoot>\config\admin\migrate.env (Administrators only). Only DATABASE_URL belongs
# here; the deploy script takes every other setting from trapezoid.env. Never commit the copy.
DATABASE_URL=postgres://trapezoid_owner:CHANGE-ME@127.0.0.1:5432/trapezoid
