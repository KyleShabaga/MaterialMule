# Production environment for the Material Mule service (MM-T20).
# Copy to <InstallRoot>\config\materialmule.env on the host. Readable by Administrators, SYSTEM and the
# service account only (Install-MaterialMuleHost.ps1 sets this). Never commit the copy.
# Every key is validated at startup (apps/api/src/config/env.ts); see apps/api/.env.example too.

APP_ENV=production
# All interfaces, so office computers and phones can connect; the firewall limits who can.
HOST=0.0.0.0
# IT INPUT: HTTPS port (must match HttpsPort in host.config.psd1).
PORT=443
# The app role (least privilege), never the migration role or postgres. 127.0.0.1 only.
DATABASE_URL=postgres://materialmule_app:CHANGE-ME@127.0.0.1:5432/materialmule
# At least 32 random characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
LOG_LEVEL=info
BUSINESS_TIME_ZONE=America/Edmonton
PERSONAL_SESSION_HOURS=12
RECEIPT_MAX_UNITS=50
# The built web app, served from the same origin as the API.
WEB_DIST_DIR=C:\MaterialMule\current\apps\web\dist

# IT INPUT: the certificate for the production host name, trusted by office computers and phones.
# Either a PFX file and its passphrase ...
TLS_PFX_FILE=C:\MaterialMule\config\tls\materialmule.pfx
TLS_PFX_PASSPHRASE=
# ... or a PEM certificate chain and private key (leave the PFX keys empty then).
# TLS_CERT_FILE=C:\MaterialMule\config\tls\materialmule.crt
# TLS_KEY_FILE=C:\MaterialMule\config\tls\materialmule.key

# Backup status record (MM-T21): the StatusFile set in backup.config.psd1. Leave empty until the
# backup design is approved (D39); Settings -> System status then shows "not set up".
BACKUP_STATUS_FILE=

# Never in production.
ENABLE_TEST_AUTH=false

# Label printer (MM-T15) and Microsoft sign-in (MM-T05): see apps/api/.env.example. Sign-in timing
# is deferred (D38); fill these in only when that is decided. In production MICROSOFT_REDIRECT_URI
# must be https://<production host name>/sign-in/microsoft/callback.
LABEL_PRINTER_HOST=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
BOOTSTRAP_ADMIN_OBJECT_ID=
