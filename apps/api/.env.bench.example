# TRP-T19 benchmark settings. Copy to apps/api/.env.bench (git-ignored) and fill in the password and
# secret. Used by npm run bench:seed / bench:load / bench:explain, never by the Windows service.
#
# The benchmark DROPS AND REBUILDS this database. The scripts refuse APP_ENV=production and any
# database whose name lacks "bench" or "test". Never point it at the production or dev database.
APP_ENV=test
HOST=127.0.0.1
# The API that bench:load starts listens here (never the service's port).
PORT=3219
# postgres://USER:PASSWORD@127.0.0.1:5432/trapezoid_bench (role and database: docs/performance/README.md)
DATABASE_URL=postgres://trapezoid_bench:change-me@127.0.0.1:5432/trapezoid_bench
# At least 32 characters; any random value (it only signs benchmark sessions):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Same as production (deploy/windows/trapezoid.env.example), so request logging is included.
LOG_LEVEL=info
BUSINESS_TIME_ZONE=America/Edmonton
# bench:load signs in as the fictional test identities (pe, at, de, ...).
ENABLE_TEST_AUTH=true
