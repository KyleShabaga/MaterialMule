{
  "name": "@trapezoid/api",
  "version": "0.1.0",
  "private": true,
  "description": "Trapezoid backend (NestJS).",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:seed:dev": "tsx src/db/cli.ts seed-dev",
    "db:reset:test": "tsx src/db/cli.ts reset-test --env-file .env.test",
    "db:reset:dev": "tsx src/db/cli.ts seed-dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@trapezoid/shared": "^0.1.0",
    "bwip-js": "^4.11.4",
    "express": "^5.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0",
    "zxing-wasm": "^3.1.6"
  }
}
