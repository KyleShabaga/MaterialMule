# Copy to .env (development) or .env.test (tests) and fill in real values.
# Never commit the copies. Keys are validated at startup by src/config/env.ts.

# development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=3000
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://materialmule:change-me@127.0.0.1:5432/materialmule_dev
# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# IANA zone that decides the year in storage unit IDs (owner decision 2026-10-25).
BUSINESS_TIME_ZONE=America/Edmonton
# Personal sign-ins expire this many hours after sign-in, never extended (owner decision 2026-10-25).
PERSONAL_SESSION_HOURS=12
# Optional receiving label printer: Zebra ZD621 on raw TCP port 9100 (MM-T15). Leave the host
# empty until IT gives the printer a fixed IP. When set, the API creates the "receiving" printer
# the first time it starts; after that an admin changes printers under Settings > Printers.
# Print requests can only name a configured printer, never a host or port.
LABEL_PRINTER_HOST=
LABEL_PRINTER_PORT=9100
LABEL_PRINTER_NAME=Receiving ZD621
# Most storage units one receipt may confirm, 1–50 (owner decision 2026-10-25: 50).
RECEIPT_MAX_UNITS=50
# Development/test only: fixture sign-in at /sign-in/test (MM-T33). Refused in production.
ENABLE_TEST_AUTH=false

# --- Microsoft Entra ID sign-in (MM-T05) -------------------------------------------------------
# Off unless all four of TENANT_ID, CLIENT_ID, CLIENT_SECRET and REDIRECT_URI are set (a partial
# set is refused at startup). Values come from IT's single-tenant app registration:
#   - Directory (tenant) ID and Application (client) ID: GUIDs from the app's Overview page.
#   - Client secret: Certificates & secrets. Server-side only; never commit it.
#   - Redirect URI (platform "Web"): the browser route /sign-in/microsoft/callback on this
#     server's origin, registered exactly, e.g. https://materialmule.example.local/sign-in/microsoft/callback
#     (http://127.0.0.1:5173/sign-in/microsoft/callback for `npm run dev`; use 127.0.0.1, not
#     localhost: Vite binds 127.0.0.1 and the sign-in cookie must come back to the same host).
#   - API permissions: Microsoft Graph delegated User.Read only (plus openid, profile).
#   - Optional claims (recommended): ID token "acct" so guest accounts are refused reliably.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Leave unset in real environments. Tests point these at a mock tenant (http allowed only
# outside production).
# MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
# First administrator: their Entra object ID (preferred; Entra admin centre > Users > Object ID).
# BOOTSTRAP_ADMIN_UPN is used only when no object ID is set. Matching accounts become active
# admins at first sign-in; nobody else does.
BOOTSTRAP_ADMIN_OBJECT_ID=
BOOTSTRAP_ADMIN_UPN=

# --- HTTPS (MM-T20) ---------------------------------------------------------------------------
# Required in production (the API serves HTTPS itself and sends HSTS); leave empty for development
# and tests. Either a PFX file (+ passphrase) or a PEM certificate chain and key, from IT.
# Production template and host steps: deploy/windows/materialmule.env.example, docs/operations/runbook.md.
TLS_PFX_FILE=
TLS_PFX_PASSPHRASE=
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Backups and system status (MM-T21) ------------------------------------------------------
# Optional. The status record deploy/windows/backup.ps1 writes (StatusFile in backup.config.psd1),
# shown under Settings → System status. Leave empty until the backup design is approved (D39).
BACKUP_STATUS_FILE=

# --- Action-request email (MM-T27) -----------------------------------------------------------
# Must stay false: email sending is switched off for everyone until IT approves the sending
# configuration and privacy review. People can still opt in under Settings → My profile; their
# outbox rows wait unsent. Development and tests never send email.
EMAIL_ENABLED=false
