# Copy to .env (development) or .env.test (tests) and fill in real values.
# Never commit the copies. Keys are validated at startup by src/config/env.ts.

# development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=3000
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://trapezoid:change-me@127.0.0.1:5432/trapezoid_dev
# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# IANA zone that decides the year in storage unit IDs (owner decision 2026-10-25).
BUSINESS_TIME_ZONE=America/Edmonton
# Personal sign-ins expire this many hours after sign-in, never extended (owner decision 2026-10-25).
PERSONAL_SESSION_HOURS=12
