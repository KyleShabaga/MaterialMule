# Copy to .env (development) or .env.test (tests) and fill in real values.
# Never commit the copies. Keys are validated at startup by src/config/env.ts.

# development | test | production
APP_ENV=development
HOST=127.0.0.1
PORT=3000
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://trapezoid:change-me@127.0.0.1:5432/trapezoid_dev
# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# IANA zone that decides the year in storage unit IDs (owner decision 2026-10-25).
BUSINESS_TIME_ZONE=America/Edmonton
# Personal sign-ins expire this many hours after sign-in, never extended (owner decision 2026-10-25).
PERSONAL_SESSION_HOURS=12
# Most storage units one receipt may confirm, 1–50 (owner decision 2026-10-25: 50).
RECEIPT_MAX_UNITS=50
# Development/test only: fixture sign-in at /sign-in/test (TRP-T33). Refused in production.
ENABLE_TEST_AUTH=false

# --- Microsoft Entra ID sign-in (TRP-T05) -------------------------------------------------------
# Off unless all four of TENANT_ID, CLIENT_ID, CLIENT_SECRET and REDIRECT_URI are set (a partial
# set is refused at startup). Values come from IT's single-tenant app registration:
#   - Directory (tenant) ID and Application (client) ID: GUIDs from the app's Overview page.
#   - Client secret: Certificates & secrets. Server-side only; never commit it.
#   - Redirect URI (platform "Web"): the browser route /sign-in/microsoft/callback on this
#     server's origin, registered exactly, e.g. https://trapezoid.example.local/sign-in/microsoft/callback
#     (http://localhost:5173/sign-in/microsoft/callback for `npm run dev`).
#   - API permissions: Microsoft Graph delegated User.Read only (plus openid, profile).
#   - Optional claims (recommended): ID token "acct" so guest accounts are refused reliably.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Leave unset in real environments. Tests point these at a mock tenant (http allowed only
# outside production).
# MICROSOFT_AUTHORITY_HOST=https://login.microsoftonline.com
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
# First administrator: their Entra object ID (preferred; Entra admin centre > Users > Object ID).
# BOOTSTRAP_ADMIN_UPN is used only when no object ID is set. Matching accounts become active
# admins at first sign-in; nobody else does.
BOOTSTRAP_ADMIN_OBJECT_ID=
BOOTSTRAP_ADMIN_UPN=
